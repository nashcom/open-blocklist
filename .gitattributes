# Normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly mark common text types
*.go    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.toml  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf

# Explicitly mark binary types (no line-ending conversion)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
