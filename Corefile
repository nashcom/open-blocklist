open-blocklist.internal {

   forward . 172.30.0.10:5353

    cache 10
    log
    errors
}

open-blocklist-etcd.internal {
    etcd {
        path /skydns
        endpoint http://172.30.0.20:2379
    }

    cache 10
    log
    errors
}


in-addr.arpa {
    etcd {
        path /skydns
        endpoint http://172.30.0.20:2379
        fallthrough
    }

    forward . /etc/resolv.conf
    cache 30
    log
    errors
}
